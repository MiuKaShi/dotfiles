#!/bin/bash

# Sends a notification with the current volume level
function send_notification() {
    local volume=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{printf "%.0f", $2 * 100}')
    notify-send -a Volume -u low -r 993 -h int:value:"$volume" -i "volume-$1" "Volume: ${volume}%" -t 2000
}

# Toggles mute on/off
toggle_mute() {
    wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
    [[ "$(wpctl get-volume @DEFAULT_AUDIO_SINK@)" == *"[MUTED]"* ]] && notify-send -a Volume -i volume-mute -t 2000 -r 993 -u low "Muted" \
        || notify-send -a Volume -i volume-unmute -t 2000 -r 993 -u low "Unmuted"
}

# Main script
case $1 in
    up)
        wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
        send_notification up
        ;;
    down)
        wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
        send_notification down
        ;;
    toggle)
        toggle_mute
        ;;
esac

pkill -RTMIN+10 "${STATUSBAR:-dwmblocks}"
