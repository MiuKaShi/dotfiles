#!/bin/bash

HOME="/home/$(whoami)"
RDPHOSTS=$HOME/.rdphosts
HOSTNAME=$(awk '{print $1}' "$RDPHOSTS" | dmenu -i -p "Please Select Host") || exit 0
HOSTINFO=$(grep "$HOSTNAME" "$RDPHOSTS")

SCALE=$(printf "140\n180\n100" | dmenu -p "Choose Scale:")

read -r IP NET USER PASS MAC <<<"$(echo "$HOSTINFO" | awk '{print $2, $3, $4, $5, $6}')"
RDP_IP="${IP%:*}"
RDP_PORT="${IP##*:}"

rdp_available() {
    nc -z -w 3 "$RDP_IP" "$RDP_PORT"
}

if ! rdp_available; then
    wol "$MAC" && notify-send "Waking up PC!"
    until rdp_available; do
        :
    done
fi

sleep 1

xfreerdp3 \
    +dynamic-resolution \
    /clipboard \
    +aero \
    +window-drag \
    +menu-anims \
    /cache:bitmap:on,glyph:on,offscreen:on,persist \
    -compression \
    -themes \
    /bpp:32 \
    /scale:"$SCALE" \
    -grab-keyboard \
    /gfx:AVC444:on,AVC420:on,progressive:on,small-cache:on,frame-ack:on \
    +rfx \
    /rfx-mode:video \
    /gdi:hw \
    /cert:ignore \
    /auto-reconnect \
    /auto-reconnect-max-retries:3 \
    /audio-mode:0 \
    /sound:sys:pulse \
    /u:"$USER" /v:"$IP" /p:"$PASS" /network:"$NET" /drive:home,"$HOME" &
# /f \
# /log-level:OFF \
